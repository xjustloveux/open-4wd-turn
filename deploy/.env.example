# 複製為 .env 後逐項填寫。此檔為樣本：不得放真實 secret 進公版 repo。
# 與 open-4wd-signaling 部署的 TURN_SHARED_SECRET 必須同值（token 簽發↔驗證）。
TURN_SHARED_SECRET=change-me-shared-with-signaling
# TURN realm（建議用獨立子域名，如 turn.example.org）。
REALM=turn.example.org
# 本機的公網 IP（host 網路模式必填）。
EXTERNAL_IP=203.0.113.10
# 配對 signaling 回給 client 的 URL（多個以逗號分隔）；coturn 本身不讀此欄。
TURN_URLS=turn:turn.example.org:3478?transport=udp,turn:turn.example.org:3478?transport=tcp
# relay 埠段（每個中繼會話佔一個 UDP 埠；收窄範圍＝封頂並發中繼數）。
MIN_PORT=49152
MAX_PORT=65535
# 單一使用者同時 allocation 數上限。
USER_QUOTA=12
# 全伺服器同時 allocation 數上限。
TOTAL_QUOTA=1200
# 單一會話頻寬上限（bytes/sec；0＝不限）。
MAX_BPS=0
