# 本機部署產物——環境真值與渲染後設定可能含明文 secret，絕不入版控。
.env
.env.*
!.env.example
!.env.*.example
/turnserver.conf
/deploy/turnserver.conf
# deploy workflow 在 repo 根暫存 kubeconfig 並於收尾步驟刪除；本機比照操作時同樣不得入庫。
/kubeconfig

# TLS 私鑰與私密金鑰容器（公開憑證檔可按部署需求納入版控）
*.key
*.pem
*.p12
*.pfx

# IDE / local agent state
.idea/
.vscode/
/.superpowers/
/docs/superpowers/

# 本機 agent workflow 接線：.claude/.agents 下的 skill 目錄是指向工作區 open-4wd-workflow
# repo 的 Windows junction，Git on Windows 會當一般目錄走訪——未忽略即整包外部檔案入庫。
# 規則放這裡而非 .git/info/exclude：後者不隨 clone 移動，.git 一旦重建即失效。
/AGENTS.override.md
/CLAUDE.local.md
/.agents/skills/open-4wd-workflow/
/.agents/skills/graphify/
/.claude/skills/open-4wd-workflow/

# System files
.DS_Store
Thumbs.db
desktop.ini

# Python test bytecode cache
__pycache__/
*.py[cod]

# graphify 知識圖：大圖／報告／HTML 不入版控（可隨時重生成）；
# 語意 cache＋manifest＋labels 入版控＝任何 clone 0 token 重建（掃描白名單見 .graphifyignore）
/graphify-out/*
!/graphify-out/cache/
/graphify-out/cache/*
!/graphify-out/cache/semantic/
!/graphify-out/manifest.json
!/graphify-out/.graphify_labels.json
/graphify-release/
